# =========================
# Foundry
# =========================
out/
cache/
broadcast/
artifacts/
# EXCEPTION: public/artifacts/ is not a build directory — it is SHIPPED STATIC
# CONTENT. The console's launch rail fetches /artifacts/payments.json to build
# the deploy calldata, and the worker serves it out of the ASSETS binding, which
# is populated from what's committed here. If this stays ignored, the deploy
# lands with no artifact, the fetch 503s, and the rail silently stays in
# preview. Re-included deliberately; regenerate with GenTemplateArtifact.s.sol.
!public/artifacts/
!public/artifacts/**

# =========================
# Dependencies
# =========================
# NOTE: do NOT ignore lib/ — dependencies are git submodules (gitlinks are
# tracked in-tree, submodule contents never are). Ignoring lib/ silently
# blocked `git submodule add` / `forge install` for new deps (base-std).

# =========================
# Node (if any frontend tools)
# =========================
node_modules/
# NOTE: lockfiles (package-lock.json etc.) are COMMITTED, never ignored —
# CI uses `npm ci`, and an unpinned production worker is a supply-chain hole.

# =========================
# Environment / Secrets
# =========================
.env
.env.*
.env.local

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Editor / IDE
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Logs
# =========================
*.log

# Generated build/test tee reports (kept on disk, not in history)
compile.txt
report.txt
grep_v4api.txt
reports/

# =========================
# Python (your models/)
# =========================
__pycache__/
*.pyc

# Wrangler local dev state
.wrangler/

# =========================
# MCP local config (holds RPC tokens / keys — NEVER commit)
# =========================
.mcp.json
.mcp.local.json

# Wrangler local secrets (NEYNAR_API_KEY etc) — NEVER commit
.dev.vars
.dev.vars.*

# =========================
# Keeper runtime state — NEVER commit
# =========================
# The live rule ledger holds real user wallet addresses; positions.example.json
# is the committed template. Keypair files hold the keeper's secret.
keeper/positions.json
keeper/*.key
keeper/*keypair*.json
