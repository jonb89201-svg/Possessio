// possessio-radar — its OWN worker (session ledger: radar gets its own worker;
// the console worker stays the console's). Deployed by the Architect:
//   cd radar && npm install && npx wrangler deploy
// No secrets: the toll sink is a public address, prices are public, and the
// x402 middleware verifies payments via the facilitator — this worker holds
// no keys at all.
{
  "name": "possessio-radar",
  "main": "index.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"], // @x402/extensions imports node:url
  "triggers": { "crons": ["* * * * *"] }, // every minute; both watcher jobs run per tick

  // Layer 3: the real-time engine (pumptape.ts). SQLite-backed DO class.
  "durable_objects": {
    "bindings": [{ "name": "PUMPTAPE", "class_name": "PumpTape" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PumpTape"] }],

  "d1_databases": [
    {
      "binding": "RADAR_DB",
      "database_name": "possessio-radar-ledger",
      "database_id": "e7f0f7fd-a1cc-4c7c-97eb-a2eb6c19ecde" // live; schema verified by read-back 2026-07-06
    }
  ],
  "vars": {
    "TOLL_SINK": "0x0000000000000000000000000000000000000000", // zero = TOLL_NOT_ARMED free mode; wave GATE 4 fills it
    "TOLL_NETWORK": "base-sepolia", // wave cutover flips to "base" (CAIP-2 derived in code)
    // FACILITATOR_URL unset -> default https://facilitator.x402.org; cutover may
    // point at the Coinbase CDP facilitator per current x402 docs.
    // Prices OPEN — Architect ratifies after >=1 week of tape (pricing memo).
    "PRICE_GAP_STATS": "$0.005",
    "PRICE_SESSION_GATE": "$0.01",
    "PRICE_TAPE": "$0.02",
    // Watcher (RADAR_HANDOFF). VERIFY-FIRST gate CLEARED 2026-07-06: the
    // Architect's terminal proved this exact route answers 200 ANONYMOUSLY
    // with live token objects newest-first, shape matching the normalizer
    // (mint / created_timestamp / usd_market_cap). limit=50 for the poller's
    // lookback window; includeNsfw=true stays - a birth radar that filters
    // births isn't a birth radar. If this ever starts demanding a JWT, the
    // fallback seams from the handoff apply (PumpPortal WS via Durable
    // Object; keyed feeds last resort).
    "PUMPFUN_FEED_URL": "https://frontend-api-v3.pump.fun/coins?offset=0&limit=1000&sort=created_timestamp&order=DESC&includeNsfw=true", // R-3: limit 50->300; R-9 (2026-07-11): 300->1000 (the feed's documented default/max). WHY: screenScan TRACKS a candidate from age ~4min to age 10min against this same newest-first window. At limit=300 the window only spans ~300/birthrate minutes; live tape showed coins present at qualify (age ~5min) but GONE by age ~7min (span < 10min), so tracking read mc=null every intermediate tick and every candidate rode frozen (entry==peak==last) to timestop. 1000 keeps a coin visible for the full 10min window at birth rates up to ~100/min (vs ~30/min at 300), covering the ~50/min bursts observed. Also makes birthScan burst-proof.
    "DEXSCREENER_TOKEN_URL": "https://api.dexscreener.com/latest/dex/tokens/", // official public API
    // Layer 3 feed. VERIFY-FIRST executes THROUGH the deployment: sandbox
    // egress is blocked, so /radar/ws-status (connection state, parse rate,
    // raw samples) is the live gate — pin the shape there before trusting it.
    "PUMPPORTAL_WS_URL": "wss://pumpportal.fun/api/data",
    "DISCOVERY_BATCH": "900", // R-5: young tokens swept per tick; batched 30/request = <=30 req/tick, well under DexScreener 300 req/min
    "EXPIRE_HOURS": "24", // birth older than this without discovery -> status 'expired' (bulk sweep)
    "YOUNG_WINDOW_MIN": "30", // R-8 (2026-07-08): tightened 120->30 per the Architect - trading only cares about <30min coins; tape's own data (median time-to-peak 8min) supports it. TRADEOFF: true graduations (measured median gap 41min) mostly happen AFTER 30min and will now go unrecorded (token ages out of the poll window, sits watching until 24h auto-expire). Population-level graduation-rate stats are DEGRADED from here forward; tonight's validated priors (1.59% grad rate) stand as the last clean measurement.
    "DEX_TRACK_HOURS": "1", // hour-by-hour ledger (2026-07-15): post-graduation DEX enrich window. Was 48h hard-coded — re-scanning 2 days of graduates every minute was the bandwidth drag behind the tape stalls. 1h gives the worker a break from previous coins; raise if longer post-grad tracking is wanted.
    "BIRTHS_KEEP_HOURS": "48", // retention for status='expired' births before the prune sweep deletes them (discoveryScan). Bounds the previously-unbounded births table (~1,277/hr). 'discovered' graduates and watching rows are never pruned.
    "RAW_JSON_KEEP_MIN": "30", // minutes to keep raw_birth_json before nulling it (discoveryScan). It's only read during the qualify window; retaining it over 48-72h of births filled D1 to its size cap and halted all writes (2026-07-16). Nulling caps DB growth while keeping the row for dev-rep.
    "DEV_REP_MAX_PRIOR": "20", // dev-reputation paper gate (migration 0019): a qualifying coin's creator counts as "fresh" (gate_dev=1) if it launched <= this many coins before this one; above it = serial (gate_dev=0). Backtest 2026-07-16: fresh devs hit +20% 49.5% vs 21.9% for 21+ serials. Paper signal only — nothing is skipped or traded.
    "RUG_MAX_TOP_HOLDER_PCT": "0.20", // rug gate (migration 0020): a qualifying coin passes (gate_rug=1) if its largest non-curve holder holds <= this share of the circulating float; above = whale-on-float (gate_rug=0). Forward-measured; needs the SOLANA_RPC_URL secret to activate (gate stays NULL until then). Paper signal only.
    "STRAT_VEL_LO": "7",              // go-to strategy (migration 0021): min entry velocity ($MC/sec climb into the band) for the momentum sweet-spot. Below = slow fade. Backtest: moderate-fast momentum wins +10% ~60% vs ~37% at the extremes.
    "STRAT_VEL_HI": "20",            // go-to strategy: max entry velocity. Above = parabolic top (already dumping). strat_take requires vel within [LO,HI].
    "STRAT_TARGET_PCT": "0.50",      // go-to strategy: take-profit as fraction over entry (let winners run). Expectancy rose monotonically to +50% in the backtest (rug-filtered ceiling +19.6%/trade). Tunable.
    "STRAT_STOP_PCT": "0.40",        // go-to strategy: stop-loss as fraction under entry. Sensible risk cap (≈ the legacy $6k stop in %-terms); not separately optimized — tune forward.
    // §0 SESSION GATE (sessiongate.ts). The proxy is births/hour (pump.fun launch
    // rate) vs its own trailing 7d average — a RELATIVE gate (§0). Every value
    // below is a STARTING POINT, not frozen (§0/§7): the threshold gets tuned by
    // ledger correlation once real gate-reading-vs-outcome data exists. Overridable
    // here (or via `wrangler secret`/deploy var) with no code change.
    "SESSION_GATE_THRESHOLD": "0.65", // §0 "~60–70%" — sit out if window < 65% of the 7d avg rate
    "SESSION_WINDOW_HOURS": "24",     // §0 "last 1–24h" trailing window
    "SESSION_BASELINE_DAYS": "7",     // §0 "trailing 7-day average"
    "SESSION_RECOMPUTE_MS": "3600000" // cadence: recompute hourly (a 7d baseline barely moves in 60s)
  }
}
